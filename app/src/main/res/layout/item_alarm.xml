<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_bg"
    android:padding="18dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/cardContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07:30"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#F1F5F9" />

            <TextView
                android:id="@+id/txtAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" AM"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#38BDF8"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/txtScheduleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAILY"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#22C55E"
                android:background="#14532D"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtAlarmCardLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Note: Wake up"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#E2E8F0"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to edit time &amp; note"
            android:textSize="11sp"
            android:textColor="#475569"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DELETE"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#F87171"
        android:background="@android:color/transparent" />
</LinearLayout>
