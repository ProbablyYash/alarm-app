<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1D"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AlArm"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC" />

        <TextView
            android:id="@+id/txtUpcomingNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No alarms scheduled"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:textColor="#64748B" />

        <!-- Global Personalization Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_bg"
            android:padding="12dp"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnSetGlobalWallpaper"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Set Wallpaper"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#334155" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnSetGlobalTone"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Set Tone"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#334155" />
        </LinearLayout>
    </LinearLayout>

    <ListView
        android:id="@+id/alarmListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@+id/btnAddAlarm"
        android:layout_marginTop="12dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="14dp" />

    <Button
        android:id="@+id/btnAddAlarm"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:text="+ Add New Alarm"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2563EB"
        android:layout_marginTop="12dp" />
</RelativeLayout>
